# Copy to backend/.env for local development. Never commit the real .env.
DATABASE_URL=postgresql+psycopg://localhost/dooh
MEDIA_DIR=../media
ADMIN_PASSWORD=change-me
SECRET_KEY=change-me-to-a-long-random-string

# Cloud server only (set in the host's variables, not in a file):
# ENVIRONMENT=production   # refuses to start without a 12+ character
#                          # ADMIN_PASSWORD and a 32+ character SECRET_KEY
# DAILY_BACKUPS=true       # pg_dump once a day into BACKUP_DIR
# BACKUP_DIR=/data/backups
# BACKUP_KEEP_DAYS=14
# WEBSITE_API_KEY=...       # 32+ chars; enables POST /api/website/orders
# ORDER_FILE_HOSTS=.supabase.co
# MONITORING=true          # offline / not-playing alerts and the daily report
# RESEND_API_KEY=re_...
# ALERT_EMAIL_TO=you@example.com
# PUBLIC_URL=https://your-dashboard.example.com
